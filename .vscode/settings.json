{
    // IPython kullan (Spyder gibi)
    "python.terminal.activateEnvironment": true,
    "python.terminal.executeInFileDir": true,
    "python.terminal.launchArgs": ["-m", "IPython", "--no-banner"],
    
    // F9 ile seçimi çalıştır
    "jupyter.interactiveWindow.textEditor.executeSelection": true,
    
    // Değişkenleri göster (Spyder Variable Explorer gibi)
    "jupyter.variableExplorerHeight": 300,
    
    
    // Sonuçları hemen göster
    "python.terminal.focusAfterLaunch": false,

    
    
    // Satır çalıştır, alta geç (default behavior)
    "jupyter.interactiveWindow.textEditor.autoMoveToNextCell": true,

    // Hücre çalıştır, alta geç
    "jupyter.interactiveWindow.runCellAndAddBelow": true,

    // Text editor çalıştır, alta geç kısayolu Shift+Enter
    "multiCommand.commands": [
        {
            "command": "multiCommand.runAndMoveDown",
            "sequence": [
                
                "jupyter.execSelectionInteractive",
                "cursorDown"
            ]
        }
    ],
    "python-envs.pythonProjects": [
        {
            "path": "",
            "envManager": "ms-python.python:conda",
            "packageManager": "ms-python.python:conda"
        }
    ]

    
    
}